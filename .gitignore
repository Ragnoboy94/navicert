# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# заявки с форм (персональные данные)
/data/leads.json

# статьи и загруженные фото — только на сервере / у редактора, не в git
/content/articles.json
/public/images/articles/

# рассылка: runtime-данные, токены, история (не коммитить)
/data/fsa-token.json
/data/outreach-queue.json
/data/outreach-sent.json
/data/outreach-unsubscribed.json
/data/outreach-schedule.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# временные скрипты отладки
scripts/_*
scripts/outreach/_*

# vpn: сгенерированный конфиг и одноразовые prod-скрипты (креды в env)
scripts/vpn/*.json
scripts/vpn/*.py

# браузеры Playwright для парсера ФСА
.playwright-browsers/
