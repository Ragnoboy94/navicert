ADMIN_PASSWORD=change-me-in-production
# На проде обязательно: https://navicert.pro — для canonical, RSS, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cookie secure: auto по HTTPS. На HTTP до certbot оставьте false или не задавайте.
# COOKIE_SECURE=false

# Уведомления о заявках в Telegram (создайте бота через @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Письмо о заявке (Mail.ru SMTP).
# Обычный пароль от ящика НЕ подойдёт — создайте «пароль для внешнего приложения»:
# https://e.mail.ru/ → Настройки → Безопасность → Пароли для внешних приложений → Создать → SMTP
SMTP_HOST=smtp.mail.ru
# Локально: 465. На VPS (AEZA и др.): 2525 — порты 465/587 часто заблокированы.
SMTP_PORT=465
SMTP_USER=informer@navicert.pro
SMTP_PASS=
SMTP_FROM=informer@navicert.pro
NOTIFY_EMAIL=informer@navicert.pro

# Рассылка по реестру ФСА (отдельный SMTP, не смешивать с заявками на informer@navicert.pro)
# OUTREACH_TEST_MODE=true — все письма уходят на OUTREACH_TEST_EMAIL, не клиентам (на проде: false)
OUTREACH_SMTP_HOST=smtp.yandex.ru
# Yandex: 587 (STARTTLS). На AEZA после открытия портов — напрямую; SOCKS только если снова закроют.
OUTREACH_SMTP_PORT=587
# OUTREACH_SMTP_PROXY=socks5://host:1080
OUTREACH_SMTP_USER=a.gromov@navicert-info.ru
OUTREACH_SMTP_PASS=
OUTREACH_SMTP_FROM=a.gromov@navicert-info.ru
# OUTREACH_REPLY_TO= — не задавайте, если ответы не нужны
OUTREACH_TEST_MODE=false
OUTREACH_TEST_EMAIL=still-1994@mail.ru
OUTREACH_SENDER_NAME=Экспертный центр сертификации Нависерт
OUTREACH_FROM_NAME=Андрей Грумов
# Пауза между письмами в одной партии (мс)
OUTREACH_SEND_DELAY_MS=3000
# Пауза перед повторным письмом на тот же email (другая декларация), дней
OUTREACH_RECIPIENT_COOLDOWN_DAYS=7
# Секрет для cron-эндпоинта (/api/outreach/cron): почасовая догрузка ФСА + автоотправка
# Вызывайте каждые 15–20 мин (на проде */20 в crontab). Раз в час — +100 деклараций из реестра.
OUTREACH_CRON_SECRET=
# Токен из DevTools браузера на pub.fsa.gov.ru (Network → Authorization: Bearer ...)
# Локально обновляется через Playwright (get-fsa-token.mjs); на проде — свой data/fsa-token.json
FSA_BEARER_TOKEN=
# --- ФСА: сеть ---
# Локаль (NEXT_PUBLIC_SITE_URL=http://localhost:3000 или без OUTREACH_FSA_PROXY):
#   всегда прямой доступ к pub.fsa.gov.ru (РФ).
# Прод (SITE_URL=https://navicert.pro + OUTREACH_FSA_PROXY на сервере):
#   HTTP-прокси купленный, схема http://user:pass@host:8000
#   (в кабинете «HTTPs/SOCKS5» — для Node/curl к ФСА используем http://)
# OUTREACH_FSA_PROXY=http://user:pass@host:8000
# Сколько записей обогащать за один фоновый запрос (API + карточки)
OUTREACH_ENRICH_BATCH=50
# Сколько карточек открывать через Playwright за один запрос
OUTREACH_CARD_BATCH=8
# Секрет для подписи ссылок отписки (на проде задайте отдельный)
OUTREACH_UNSUBSCRIBE_SECRET=
# Срок переоформления в тексте письма (категория «Заканчивающиеся»)
OUTREACH_CERT_DURATION=до 2 месяцев

# Альтернатива: ID счётчика можно задать здесь или в админке (со старого сайта: 106623545)
NEXT_PUBLIC_YM_ID=106623545
